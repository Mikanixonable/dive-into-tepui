+// 気象モデルから地表風と陸海を焼く風テクスチャ(ベイクドフィールド)。粒の移流と陸海の
+// 条件づけが描画時に読む、雲場と同じ投影の場。
+import * as THREE from 'three/webgpu';
+import { BakedField } from '../baked-field';
+import { GPU_PASS } from '../gpu-timings';
+import { windTexelFromSample } from './cloud-wind-sample';
+import type { WebGPURenderer } from 'three/webgpu';
+import type { GpuTimingSink } from '../gpu-timings';
+import type { FieldProjection } from '../field-projection';
+import type { WeatherModel } from './weather-model';
+
+export class CloudWindField {
+  private readonly field: BakedField;
+
+  // model の現在時刻における地表風と陸海を、指定された projection に従ってベイクするテクスチャ。
+  public constructor(model: WeatherModel, projection: FieldProjection) {
+    this.field = new BakedField('wind', THREE.RGBAFormat, projection, (direction) => {
+      const weather = model.weatherAt(direction);
+      return windTexelFromSample({ wind: weather.surfaceWind, land: weather.landFraction });
+    }, GPU_PASS.cloudBake);
+  }
+
+  // 現在時刻の風をベイクドテクスチャへレンダリングする。読む前に必ず一度呼び出す。
+  public render(renderer: WebGPURenderer, gpu?: GpuTimingSink): void {
+    this.field.render(renderer, gpu);
+  }
+
+  // 焼いた風の場。テクスチャの所有権は BakedField に残す。
+  public get texture(): THREE.Texture { return this.field.texture; }
+
+  // 保持している GPU 資源を解放する。
+  public dispose(): void {
+    this.field.dispose();
+  }
+}
diff --git a/src/render/cloud/cloud-wind-sample.ts b/src/render/cloud/cloud-wind-sample.ts
new file mode 100644
index 000000000..8cba7a10b
--- /dev/null
+++ b/src/render/cloud/cloud-wind-sample.ts
@@ -0,0 +1,26 @@
+// 風テクスチャの生成値と焼いたテクスチャの読み値。風速は m/s、陸海は 0..1 で扱い、
+// RGBA の配置を表現側へ漏らさない。
+import { vec2, vec4 } from 'three/tsl';
+import type { FloatNode, Vec2Node, Vec4Node } from '../tsl-types';
+
+// 地表風の尺度。風速 [m/s] の正負の両端。lab の風ビューも同じ尺度で風を描く。
+export const WIND_SPAN = 45;
+
+// 描画時の風の標本。wind は (東, 北) 成分の地表風 [m/s]、land は陸らしさ 0..1。
+export interface WindSample {
+  readonly wind: Vec2Node;
+  readonly land: FloatNode;
+}
+
+// 焼いた風テクスチャの RGBA を、生成側と同じ単位の風標本へ戻す。
+export function windSampleFromTexel(texel: Vec4Node): WindSample {
+  return {
+    wind: vec2(texel.r, texel.g).sub(0.5).mul(2 * WIND_SPAN),
+    land: texel.b,
+  };
+}
+
+// 風標本を焼き込み用の RGBA へ戻す。読み出し側の復号と同じ契約をここで対にして持つ。
+export function windTexelFromSample(sample: WindSample): Vec4Node {
+  return vec4(sample.wind.div(2 * WIND_SPAN).add(0.5), sample.land, 1);
+}
