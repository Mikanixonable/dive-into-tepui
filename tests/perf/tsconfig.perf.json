{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": false,
    "outDir": "../dist-perf",
    "rootDir": "../..",
    "paths": {
      "three/webgpu": ["../../node_modules/@types/three/build/three.webgpu.d.ts"],
      "three/tsl": ["../../node_modules/@types/three/build/three.tsl.d.ts"],
      "three/addons/*": ["../../node_modules/@types/three/examples/jsm/*"]
    }
  },
  "include": [
    "../../src/types",
    "**/*.ts"
  ]
}
