{
  "name": "dive-into-tepui",
  "version": "0.0.1",
  "private": true,
  "description": "地球-月系を舞台とした軌道力学シューティングゲーム",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node node_modules/webpack-cli/bin/cli.js serve --mode development",
    "build": "webpack --mode production",
    "prebuild": "node tools/generate-rmqr.mjs",
    "verify:source": "node tools/verify-release.mjs --source-only",
    "verify:theme": "node tools/verify-theme-contrast.mjs",
    "verify:ui-style": "node tools/verify-ui-style.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "lint": "eslint --quiet --cache --suppressions-location eslint-suppressions.json src tests tools",
    "lint:fix:all": "eslint --fix --prune-suppressions --suppressions-location eslint-suppressions.json src tests tools",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "smoke:browser": "node tools/browser-smoke.mjs",
    "smoke:layout-suite": "node tools/layout-smoke-retry.mjs --suite",
    "ci": "node tools/run-ci.mjs",
    "typecheck": "tsc --noEmit",
    "dep-metrics": "node tools/dep-metrics.mjs",
    "test:clean": "node -e \"require('node:fs').rmSync('tests/dist', { recursive: true, force: true })\"",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:build": "npm run test:compile",
    "test:run": "node tests/dist/tests/run.js",
    "test:run:all": "npm run test:run -- all",
    "test:run:physics": "npm run test:run -- physics",
    "test:run:math": "npm run test:run -- math",
    "test:run:game": "npm run test:run -- game",
    "test:run:render": "npm run test:run -- render",
    "test:run:settings": "npm run test:run -- settings",
    "test:run:launcher": "npm run test:run -- launcher",
    "test": "npm run test:compile && npm run test:run:all",
    "test:physics": "npm run test:compile && npm run test:run:physics",
    "test:math": "npm run test:compile && npm run test:run:math",
    "test:game": "npm run test:compile && npm run test:run:game",
    "test:render": "npm run test:compile && npm run test:run:render",
    "test:settings": "npm run test:compile && npm run test:run:settings",
    "test:launcher": "npm run test:compile && npm run test:run:launcher",
    "export-assets": "node tools/model-builder/export-models.mjs",
    "export-module-thumbnails": "webpack --config webpack.render-lab.config.js --mode production && node tools/export-module-thumbnails.mjs",
    "ship-modules:author": "node tools/model-builder/author-ship-modules.mjs",
    "export-ltc-table": "node tools/export-ltc-table.mjs",
    "export-blue-noise": "node tools/export-blue-noise.mjs",
    "orbits:fetch": "node tools/fetch-orbit-catalog.mjs",
    "export-lagrange-orbits": "node tools/export-lagrange-orbits.mjs",
    "coastline:fetch": "node tools/fetch-coastline-source.mjs",
    "export-coastline": "node tools/export-coastline.mjs",
    "export-earth-smoothness": "node tools/export-earth-smoothness.mjs",
    "climate:fetch": "node tools/fetch-climate-source.mjs",
    "export-climate": "node tools/export-climate.mjs",
    "earth-surface:fetch": "python3 tools/earth-surface/fetch-source.py",
    "earth-surface:bake": "python3 tools/earth-surface/bake.py",
    "earth-surface:convert-legacy": "node tools/earth-surface/convert-legacy-terrain.mjs",
    "earth-surface:package": "node tools/earth-surface/package.mjs",
    "earth-surface:dev-stage": "node tools/earth-surface/package.mjs --input .earth-surface/bundle --output docs",
    "earth-surface:check": "node tools/earth-surface/check.mjs",
    "earth-surface:test:dev-delivery": "node tools/earth-surface/test_dev_delivery.mjs",
    "earth-surface:test:release": "node tools/earth-surface/test_release_config.mjs",
    "earth-surface:test": "node tools/earth-surface/test_contract.mjs && node tools/earth-surface/test_convert_legacy.mjs && npm run earth-surface:test:dev-delivery && npm run earth-surface:test:release",
    "earth-surface:release-check": "node tools/earth-surface/release-config.mjs",
    "earth-surface:pages-stage": "node tools/earth-surface/stage-pages.mjs",
    "earth-surface:pages-check": "node tools/earth-surface/stage-pages.mjs --check",
    "earth-surface:pages-test": "node tools/earth-surface/test_pages_layout.mjs",
    "earth-surface:capture-test": "node tools/earth-surface/test_capture.mjs",
    "earth-surface:capture": "webpack --config webpack.render-lab.config.js --mode production && node tools/render-lab-earth-surface.mjs",
    "earth-surface:serve": "node tools/earth-surface/serve.mjs",
    "export-moon-features": "node tools/export-moon-features.mjs",
    "bgm-lab": "node node_modules/webpack-cli/bin/cli.js serve --config webpack.bgm-lab.config.js --mode development",
    "render-lab": "node node_modules/webpack-cli/bin/cli.js serve --config webpack.render-lab.config.js --mode development",
    "render-lab:shot": "webpack --config webpack.render-lab.config.js --mode production && node tools/render-lab-shot.mjs",
    "render-lab:compare": "node tools/render-lab-compare.mjs",
    "render-lab:measure": "webpack --config webpack.render-lab.config.js --mode production && node tools/render-lab-measure.mjs",
    "cloud-lab": "node node_modules/webpack-cli/bin/cli.js serve --config webpack.cloud-lab.config.js --mode development",
    "cloud-lab:shot": "webpack --config webpack.cloud-lab.config.js --mode production && node tools/cloud-lab-shot.mjs",
    "cloud-lab:render-capture": "webpack --config webpack.cloud-lab.config.js --mode production && node tools/cloud-lab-render-capture.mjs",
    "cloud-lab:render-capture-timeseries": "webpack --config webpack.cloud-lab.config.js --mode production && node tools/cloud-lab-render-capture-timeseries.mjs",
    "cloud-lab:reference-fine": "node tools/cloud-lab-reference-fine.mjs",
    "cloud-lab:reference-fine-timeseries": "node tools/cloud-lab-reference-fine-timeseries.mjs",
    "cloud-lab:reference-cloudtop": "node tools/cloud-lab-reference-cloudtop.mjs",
    "cloud-lab:reference-cirrus": "node tools/cloud-lab-reference-cirrus.mjs",
    "cloud-lab:cirrus-montage": "node tools/cloud-cirrus-montage.mjs",
    "cloud-lab:reference-timeseries": "node tools/cloud-lab-reference-timeseries.mjs",
    "cloud-lab:compare": "webpack --config webpack.cloud-lab.config.js --mode production && node tools/cloud-lab-compare.mjs",
    "cloud-lab:separate": "webpack --config webpack.cloud-lab.config.js --mode production && node tools/cloud-lab-separate.mjs",
    "cloud-lab:reference": "node tools/cloud-lab-reference.mjs",
    "cloud-detail:reference": "node tools/cloud-detail-reference.mjs",
    "cloud-detail:candidates": "node tools/cloud-teacher-candidates.mjs",
    "cloud-detail:selftest": "node tools/cloud-detail-selftest.mjs",
    "cloud-detail:compare": "webpack --config webpack.render-lab.config.js --mode production && node tools/cloud-detail-compare.mjs",
    "cloud-detail:tiers": "webpack --config webpack.render-lab.config.js --mode production && node tools/cloud-detail-cirrus-tiers.mjs",
    "cloud-detail:stability": "webpack --config webpack.render-lab.config.js --mode production && node tools/cloud-detail-stability.mjs",
    "verify:hud-layout": "node tools/verify-hud-layout.mjs",
    "smoke:layout": "node tools/layout-smoke-retry.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/three": "0.185.4",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.2.2",
    "eslint": "^10.11.0",
    "globals": "17.12.0",
    "html-webpack-plugin": "^5.6.0",
    "rmqr": "^0.3.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sarap422/font-hackgen": "^1.0.0",
    "three": "0.185.1"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
