{
  "name": "dive-into-tepui",
  "version": "0.0.1",
  "private": true,
  "description": "地球-月系を舞台とした軌道力学シューティングゲーム",
  "scripts": {
    "dev": "node node_modules/webpack-cli/bin/cli.js serve --mode development",
    "build": "webpack --mode production",
    "prebuild": "node tools/generate-rmqr.mjs",
    "verify:source": "node tools/verify-release.mjs --source-only",
    "verify:theme": "node tools/verify-theme-contrast.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "smoke:browser": "node tools/browser-smoke.mjs",
    "ci": "node tools/check-three-pin.mjs && npm run verify:source && npm run verify:theme && npm run typecheck && npm run protein:validate && npm run protein:validate-structure && npm run test:physics && npm run build && npm run verify:release && npm run smoke:browser",
    "typecheck": "tsc --noEmit",
    "test:physics": "tsc -p tsconfig.test.json && node tests/dist/tests/physics/index.js",
    "export-assets": "node tools/export-models.mjs",
    "protein:author": "python3 tools/protein-builder/build-protein.py --require-blender",
    "protein:validate": "node tools/protein-builder/validate-protein.mjs src/assets/models/pdb5i4rProtein.json && node tools/protein-builder/validate-protein.mjs src/assets/models/myoglobin1mbnProtein.json",
    "protein:generate": "node tools/protein-builder/generate-protein-asset.mjs",
    "protein:generate-structure": "node tools/protein-builder/generate-protein-structure.mjs",
    "protein:validate-structure": "node tools/protein-builder/validate-protein-structure.mjs src/assets/models/pdb5i4rStructure.json && node tools/protein-builder/validate-protein-structure.mjs src/assets/models/myoglobin1mbnStructure.json",
    "bgm-lab": "node node_modules/webpack-cli/bin/cli.js serve --config webpack.bgm-lab.config.js --mode development",
    "render-lab": "node node_modules/webpack-cli/bin/cli.js serve --config webpack.render-lab.config.js --mode development",
    "render-lab:shot": "webpack --config webpack.render-lab.config.js --mode production && node tools/render-lab-shot.mjs"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.2.2",
    "html-webpack-plugin": "^5.6.0",
    "rmqr": "^0.3.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sarap422/font-hackgen": "^1.0.0",
    "three": "0.185.1"
  }
}
