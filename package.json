{
  "name": "dive-into-tepui",
  "version": "0.0.1",
  "private": true,
  "description": "地球-月系を舞台とした軌道力学シューティングゲーム",
  "scripts": {
    "dev": "node node_modules/webpack-cli/bin/cli.js serve --mode development",
    "build": "webpack --mode production",
    "prebuild": "node tools/generate-rmqr.mjs",
    "verify:source": "node tools/verify-release.mjs --source-only",
    "verify:release": "node tools/verify-release.mjs",
    "smoke:browser": "node tools/browser-smoke.mjs",
    "ci": "npm run verify:source && npm run typecheck && npm run test:physics && npm run build && npm run verify:release && npm run smoke:browser",
    "typecheck": "tsc --noEmit",
    "test:physics": "tsc -p tsconfig.test.json && node tests/dist/tests/physics/index.js",
    "export-assets": "node tools/export-models.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.2.2",
    "html-webpack-plugin": "^5.6.0",
    "rmqr": "^0.3.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sarap422/font-hackgen": "^1.0.0",
    "three": "^0.169.0"
  }
}
