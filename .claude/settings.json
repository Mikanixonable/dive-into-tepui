{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/remind-after-src-edit.mjs\" 2>/dev/null || true",
            "statusMessage": "コメント方針・DEVELOP/ 文書のチェック",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
