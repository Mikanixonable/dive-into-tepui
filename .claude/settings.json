{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node tools/usage-limits.mjs --brief 2>/dev/null || true",
            "statusMessage": "利用枠(Claude 5h・週間 / SWE-2)の確認",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/remind-after-src-edit.mjs\" 2>/dev/null || true",
            "statusMessage": "コメント方針・DEVELOP/ 文書のチェック",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-boundaries.mjs\" 2>/dev/null || true",
            "statusMessage": "責務境界(ARCHITECTURE)の違反チェック",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/remind-after-rule-edit.mjs\" 2>/dev/null || true",
            "statusMessage": "規則・検査を緩めていないかのチェック",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
