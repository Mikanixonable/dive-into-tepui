    "src/render/geometry-validator.ts",
    "src/physics/vec3.ts",
    "src/physics/attitude.ts",
    "src/physics/atmosphere.ts",
    "src/physics/ephemeris.ts",
    "src/game/plan/plan.ts",
    "src/game/plan/plan-executor-math.ts",
    "src/game/plan/plan-executor.ts",
    "src/game/hud/layout.ts",
    "src/physics/sphere-contact.ts",
    "src/physics/gravity-gradient.ts",
    "src/physics/geomagnetic.ts",
    "src/game/creative/placement-validation.ts",
    "src/game/celestial/point-field.ts",
    "src/physics/section-moments.ts",
    "src/physics/hull-loft.ts",
    "src/game/economy/resource.ts",
    "src/game/economy/resource-ledger.ts",
    "src/game/economy/propellant-compatibility.ts",
    "src/game/economy/actuator-materials.ts",
    "src/game/economy/facility.ts",
    "src/game/economy/deposit.ts",
    "src/game/economy/producibility.ts",
    "src/physics/inertia-tensor.ts",
    "src/physics/aerodynamics.ts",
    "src/game/vessel/tree.ts",
    "src/game/vessel/assembly.ts",
    "src/game/vessel/hull-structure.ts",
    "src/game/vessel/internal-volume.ts",
    "src/game/vessel/mass-properties.ts",
    "src/game/vessel/vessel-assemblies.ts",
    "src/game/vessel/heat-shield.ts",
    "src/game/vessel/capabilities.ts",
    "src/game/comms/coverage.ts",
    "src/game/comms/comm-stations.ts",
    "src/game/vessel/vessel-parts.ts",
    "src/game/vessel/part-inventory.ts",
    "src/game/economy/build-cost.ts",
    "src/game/vessel/production.ts",
