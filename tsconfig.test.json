{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": false,
    "outDir": "tests/dist",
    "rootDir": ".",
    "paths": {
      "three/webgpu": ["./node_modules/@types/three/build/three.webgpu.d.ts"]
    }
  },
  "include": [
    "src/types/json-shims.d.ts",
    "src/render/dispose-owned-render-resources.ts",
    "src/math/vec3.ts",
    "src/physics/attitude.ts",
    "src/physics/atmosphere.ts",
    "src/game/plan/plan.ts",
    "src/game/protein/protein-schema.ts",
    "src/game/protein/protein-combat-state.ts",
    "src/game/game-entity/contact-damage.ts",
    "src/game/protein/protein-runtime.ts",
    "src/physics/sphere-contact.ts",
    "src/game/creative/placement-validation.ts",
    "src/game/celestial/point-field.ts",
    "src/game/camera/focus-target.ts",
    "tests/*.ts",
    "tests/physics/**/*.ts",
    "tests/math/**/*.ts",
    "tests/game/**/*.ts",
    "tests/render/**/*.ts"
  ]
}
