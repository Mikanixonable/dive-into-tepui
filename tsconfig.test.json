{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "tests/dist",
    "rootDir": "."
  },
  "include": [
    "src/physics/vec3.ts",
    "src/physics/orbital.ts",
    "src/physics/attitude.ts",
    "src/physics/atmosphere.ts",
    "src/physics/ephemeris.ts",
    "src/physics/central-body.ts",
    "src/game/plan/plan.ts",
    "src/game/plan/plan-executor-math.ts",
    "src/game/plan/plan-executor.ts",
    "src/game/hud/layout.ts",
    "src/physics/swept-sphere.ts",
    "src/game/creative/placement-validation.ts",
    "src/game/celestial/point-field.ts",
    "tests/physics/**/*.ts"
  ]
}
