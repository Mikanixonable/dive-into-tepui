{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "tests/dist",
    "rootDir": ".",
    "paths": {
      "three/webgpu": ["./node_modules/@types/three/build/three.webgpu.d.ts"]
